[alias]
  name      = branch --show-current
  down      = !git pull --rebase origin $(git name)
  drop      = "!f() { git rebase --onto ${1}^ ${1}; }; f"
  rotate    = "!f() { git drop $1 && git cherry-pick $1; }; f"
  onup      = push
  rollback  = reset HEAD^
  allbut   = "!git push --force-with-lease $(git config branch.$(git name).pushremote) HEAD~${1:-1}:$(git name) #"
  sha       = rev-parse --short
  unrebase  = reset --hard ORIG_HEAD
  unpull    = reset --hard HEAD@{1}
  empty     = !"SHA=$(git sha HEAD); git rollback; git commit -C $SHA --allow-empty"
  debug     = !"GIT_TRACE=1 git"
